{
  "id": "A3-protected-confirmations-v1",
  "frozenAt": "2026-10-25T05:47:57.753780+00:00",
  "baseline": "Architecture-corrected current research control 0.104, rerun fresh and verified against exact saved questions and career support.",
  "priorComparator": "Frozen focused selector from A3-shortlist-v1, same inputs and simulator, 2,000 prior fresh replays; reused only as an outcome comparator, never as answer input.",
  "candidate": "Current-control discovery, no top-eight career restriction. Protect complete existing confirmation sets for candidates with at least two distinct activity contexts or one defining-interest domain. Include missing activity contexts when needed. Sets must contain at most three unasked canonical questions and fit in the remaining 24. Prioritize completion fraction then set length then broad score. Preserve current final confirmations. Continue a set while new positive evidence accumulates; stop at unknown, no, contrary evidence, support, or exhausted set/budget. No education/pay bonuses or support-rule changes. One predeclared candidate, no subsequent outcome tuning.",
  "budget": {
    "official": 60,
    "maxFollowups": 24,
    "countUnknown": true,
    "lifestyleSeparate": true,
    "noPriorFollowups": true
  },
  "cohorts": {
    "originalTotal": 1000,
    "development": 758,
    "originalHoldout": 30,
    "freshHoldout": 12,
    "expansionHoldout": 200,
    "grokEvaluation": 1000
  },
  "shortlist": "All confirmed careers retained regardless of correlation. Unconfirmed priority candidates need some recorded positive evidence, r>=0.608, and no contrary answer. This screen never creates a match; deferred careers remain browsable.",
  "guardrails": [
    "No new interests, profile edits, simulator bindings, bank wording or support-threshold changes.",
    "Question selector never receives biography, profile facts, unseen responses, cohort or pay.",
    "Same official60 and current canonical scoring in both arms.",
    "Previously inspected holdouts remain separate and are not pristine unseen validation.",
    "No app build, source edits, publication or account changes. All new files under outputs or thread visualization directory.",
    "No profile, simulator, bank or live matching changes. Same initial lead block in both arms.",
    "Only development question/trace review informed the prior hypothesis. Report previously inspected holdouts as separate evaluation groups; never claim pristine unseen validation.",
    "Each model has a new protected selector instance; no cross-model memory. Every control replay must reproduce the saved question sequence and support order.",
    "Approach 2 assets are not experiment inputs and its independently owned ongoing work is excluded from source assertions. No file in either prototype is written by this study."
  ],
